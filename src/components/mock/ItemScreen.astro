---
import Phone from "./Phone.astro";
import { ui, type Lang } from "../../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].mock.item;
---
<Phone lang={lang} title={t.title} active={1} back>
  <div class="m-card m-pad">
    <span class="m-name">{t.name}</span>
    <span class="m-sub">{t.place}</span>
    <dl class="m-dl">
      {t.rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      <div><dt>{t.warrantyLabel}</dt><dd><span class="m-tag sand">{t.warranty}</span></dd></div>
    </dl>
  </div>
  <p class="m-h">{t.logH}</p>
  <div class="m-card m-pad">
    <div class="m-stats">
      {t.stats.map(([k, v]) => (<div class="m-stat"><span>{k}</span><b>{v}</b></div>))}
    </div>
    <span class="m-sub">{t.tco}</span>
  </div>
  <p class="m-h">{t.docsH}</p>
  <div class="m-card">
    {t.docs.map(([k, v]) => (<div class="m-row"><div class="m-row-main"><span class="m-row-title">{k}</span><span class="m-meta">{v}</span></div><span class="m-arrow">↗</span></div>))}
  </div>
</Phone>
