---
import Phone from "./Phone.astro";
import { ui, type Lang } from "../../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].mock.stock;
---
<Phone lang={lang} title={t.title} active={4} back>
  <div class="m-card m-pad m-head">
    <span class="m-qr"><svg viewBox="0 0 7 7" width="44" height="44" aria-hidden="true"><path fill="currentColor" d="M0 0h3v3H0zM4 0h3v3H4zM0 4h3v3H0zM4 4h1v1H4zM6 4h1v1H6zM5 5h1v1H5zM4 6h1v1H4zM6 6h1v1H6z"/><path fill="#F7F4EE" d="M1 1h1v1H1zM5 1h1v1H5zM1 5h1v1H1z"/></svg><span>{t.label}</span></span>
    <div>
      <span class="m-name">{t.name}</span>
      <span class="m-sub">{t.forWhat}</span>
      <span class="m-tag sand">{t.level}</span>
    </div>
  </div>
  <p class="m-h">{t.refH}</p>
  <div class="m-card">
    <div class="m-row"><div class="m-row-main"><span class="m-row-title">{t.refLabel}</span><span class="m-meta m-mono">{t.ref}</span></div><span class="m-btn">{t.copy}</span></div>
    <div class="m-row"><div class="m-row-main"><span class="m-meta">{t.needs}</span></div></div>
  </div>
  <p class="m-h">{t.buyH}</p>
  <div class="m-card">
    {t.suppliers.map(([k, v]) => (<div class="m-row"><div class="m-row-main"><span class="m-row-title">{k}</span><span class="m-meta">{v}</span></div><span class="m-arrow">↗</span></div>))}
  </div>
</Phone>
