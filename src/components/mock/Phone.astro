---
// Decorative phone frame for product illustrations. Content is aria-hidden;
// the surrounding <figure> carries a text description.
import { ui, type Lang } from "../../i18n/ui";
interface Props { lang: Lang; title: string; active?: number; back?: boolean }
const { lang, title, active = 0, back = false } = Astro.props;
const t = ui[lang].mock;
---
<div class="phone" aria-hidden="true">
  <div class="phone-screen">
    <div class="m-top">
      {back ? <span class="m-back">‹</span> : <img src="/brand/housecairn-icone.svg" width="22" height="22" alt="" />}
      <span class="m-title">{title}</span>
      <span class="m-pill">{t.household} ▾</span>
    </div>
    <div class="m-body"><slot /></div>
    <div class="m-nav">
      {t.nav.map((label, i) => (
        <span class:list={["m-nav-item", { on: i === active }]}>
          <span class="m-nav-ico">{["✓", "⌂", "▤", "▥", "···"][i]}</span>
          {label}
        </span>
      ))}
    </div>
  </div>
</div>
