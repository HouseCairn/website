---
import Phone from "./Phone.astro";
import { ui, type Lang } from "../../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].mock;
const overdue = t.tasks.slice(0, 2);
const week = t.tasks.slice(2);
---
<Phone lang={lang} title={t.today}>
  <div class="m-chips"><span class="m-chip on">{t.filterAll}</span><span class="m-chip"><span class="m-av">S</span>Sam</span><span class="m-chip"><span class="m-av alt">J</span>Jo</span></div>
  <p class="m-h">{t.overdue} <b>2</b></p>
  <div class="m-card">
    {overdue.map((task) => (
      <div class="m-row">
        <div class="m-row-main">
          <span class="m-row-title">{task.title}</span>
          <span class="m-meta"><span class="m-tag late">{task.meta[0]}</span>{task.meta[1]}{task.badge && <span class="m-tag info">{task.badge}</span>}</span>
        </div>
        <span class="m-done" title={t.done}>✓</span>
      </div>
    ))}
  </div>
  <p class="m-h">{t.thisWeek} <b>2</b></p>
  <div class="m-card">
    {week.map((task) => (
      <div class="m-row">
        <div class="m-row-main">
          <span class="m-row-title">{task.title}</span>
          <span class="m-meta">{task.tone === "info" ? <span class="m-tag sand">{task.meta[0]}</span> : <span>{task.meta[0]}</span>}{task.meta[1]}</span>
        </div>
        <span class="m-done">✓</span>
      </div>
    ))}
  </div>
</Phone>
