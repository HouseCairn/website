---
import Base from "../layouts/Base.astro";
import Steps from "./Steps.astro";
import { ui, LINKS, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const r = t.roadmap;
---
<Base lang={lang} title={r.title} description={r.description} slug="roadmap">
  <section class="page-h">
    <div class="wrap narrow">
      <h1>{r.h1}</h1>
      <p class="lead">{r.lead}</p>
    </div>
  </section>
  <section class="sec" aria-label={r.h1}>
    <div class="wrap">
      <Steps lang={lang} headingLevel="h2" />
      <p class="honest"><strong>{t.home.status.honestStrong}</strong> {t.home.status.honest}</p>
      <h2 class="later-h">{r.laterH2}</h2>
      <ul class="later">
        {r.later.map((l) => <li>{l}</li>)}
      </ul>
      <a class="btn btn-p" href={LINKS.source}>{r.followCta}</a>
    </div>
  </section>
</Base>
